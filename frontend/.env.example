# Все переменные необязательны — значения по умолчанию подходят для
# локальной разработки с `docker compose up` в корне монорепозитория.
# Нужны только для `npm run dev`: в собранном образе адреса подставляет
# nginx при старте контейнера (см. docker/entrypoint.sh).

# Куда Vite проксирует запросы к API во время разработки.
API_ORIGIN=http://localhost:8000

# Куда Vite проксирует запросы к Keycloak во время разработки.
KEYCLOAK_ORIGIN=http://localhost:8080

# Базовый путь API в браузере (через прокси того же origin).
VITE_API_BASE=/api/v1

# Реалм и клиент Keycloak. Клиент должен быть public и иметь включённый
# Direct Access Grant — в поставляемом realm-export это `crm-api`.
VITE_KEYCLOAK_PATH=/kc
VITE_KEYCLOAK_REALM=crm
VITE_KEYCLOAK_CLIENT_ID=crm-api
