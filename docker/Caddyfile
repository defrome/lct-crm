# Один домен на всё приложение: nginx внутри контейнера веб-интерфейса сам
# разводит /api/, /docs, /openapi.json и /kc/ на API и Keycloak, а остальное
# отдаёт как SPA. Поэтому новых доменов и DNS-записей не требуется, а браузер
# обращается только к одному origin — у API нет CORS.
{$DOMAIN} {
	encode gzip

	# Keep the Keycloak hop in the edge proxy.  This avoids depending on the
	# frontend nginx container's DNS/proxy state for the first login request.
	# handle_path removes /kc before forwarding; KC_HOSTNAME still advertises
	# the public https://DOMAIN/kc URL for redirects and cookies.
	handle_path /kc/* {
		reverse_proxy keycloak:8080
	}

	# The frontend nginx serves the SPA and proxies API/documentation routes.
	handle {
		reverse_proxy web:80
	}
}

{$KEYCLOAK_DOMAIN} {
	encode gzip
	reverse_proxy keycloak:8080
}

{$GRAFANA_DOMAIN} {
	encode gzip
	reverse_proxy grafana:3000
}
