# Один домен на всё приложение: nginx внутри контейнера веб-интерфейса сам
# разводит /api/, /docs, /openapi.json и /kc/ на API и Keycloak, а остальное
# отдаёт как SPA. Поэтому новых доменов и DNS-записей не требуется, а браузер
# обращается только к одному origin — у API нет CORS.
{$DOMAIN} {
	encode gzip

	# Keycloak uses URLs relative to its configured public hostname.  When that
	# hostname is the application domain, its login page refers to these paths
	# without the /kc prefix.  Send them straight to Keycloak instead of letting
	# nginx's SPA fallback return index.html with a text/html MIME type.
	@keycloak_root path /realms/* /resources/* /js/* /robots.txt
	handle @keycloak_root {
		reverse_proxy keycloak:8080
	}

	# All other traffic, including /kc/*, goes through nginx.  It strips /kc/
	# before proxying to Keycloak and serves the SPA/API routes.
	handle {
		reverse_proxy web:80
	}
}

{$KEYCLOAK_DOMAIN} {
	encode gzip
	reverse_proxy keycloak:8080
}

{$GRAFANA_DOMAIN} {
	encode gzip
	reverse_proxy grafana:3000
}
