# Один домен на всё приложение: nginx внутри контейнера веб-интерфейса сам
# разводит /api/, /docs, /openapi.json и /kc/ на API и Keycloak, а остальное
# отдаёт как SPA. Поэтому новых доменов и DNS-записей не требуется, а браузер
# обращается только к одному origin — у API нет CORS.
{$DOMAIN} {
	encode gzip

	# nginx strips /kc/ before proxying to Keycloak and serves the SPA/API routes.
	# KC_HOSTNAME includes this path, so redirects and cookies stay same-origin.
	handle {
		reverse_proxy web:80
	}
}

{$KEYCLOAK_DOMAIN} {
	encode gzip
	reverse_proxy keycloak:8080
}

{$GRAFANA_DOMAIN} {
	encode gzip
	reverse_proxy grafana:3000
}
