# Общий файл конфигурации репозитория: его читает docker compose, его же
# подхватывает бэкенд при запуске из каталога backend/.
#
# --- General ---------------------------------------------------------------
# local | dev | test | staging | production
ENV=local
DEBUG=false
APP_NAME=CRM ИТ Школы
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Auth ------------------------------------------------------------------
# dev      -> identity from the X-Debug-User header (forbidden when ENV=production)
# keycloak -> identity from a Bearer JWT verified against KEYCLOAK_JWKS_URL
AUTH_MODE=dev
# Local Keycloak from docker-compose (realm "crm", client "crm-api"), running
# the app directly on the host (uvicorn), not inside the api container.
# See README "Keycloak" section for the container-to-container URLs.
KEYCLOAK_ISSUER=http://localhost:8080/realms/crm
KEYCLOAK_AUDIENCE=
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/crm/protocol/openid-connect/certs

# --- Imports ---------------------------------------------------------------
IMPORT_MAX_FILE_SIZE=20971520
IMPORT_MAX_ROWS=100000
# 0..100: how close a university name must be to be offered as a match
IMPORT_FUZZY_THRESHOLD=88

# --- Integrations (LMS / сайт) ---------------------------------------------
# fixture -> демонстрационные данные из app/integrations/fixtures
# http    -> реальный API. Источник без заданного URL всё равно останется
#            на фикстуре, поэтому чекаут работает без настройки.
# Контракт API принят по допущению — см. docs/INTEGRATIONS.md.
INTEGRATIONS_MODE=fixture
LMS_API_URL=
LMS_API_TOKEN=
WEBSITE_API_URL=
WEBSITE_API_TOKEN=
INTEGRATIONS_TIMEOUT=15
INTEGRATIONS_PAGE_LIMIT=100

# --- Pagination ------------------------------------------------------------
PAGE_SIZE_DEFAULT=50
PAGE_SIZE_MAX=200

# --- docker compose only ---------------------------------------------------
# Порты, на которых сервисы видны с хоста.
API_PORT=8000
WEB_PORT=5173
KEYCLOAK_PORT=8080
POSTGRES_EXPOSED_PORT=5432
SEED_ON_START=true

# Мониторинг слушает только петлевой интерфейс.
MONITORING_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d
GRAFANA_PORT=3000
MONITORING_BIND_ADDRESS=127.0.0.1
GRAFANA_ADMIN_USER=admin
# Change this password before exposing Grafana beyond localhost.
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000
