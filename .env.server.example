# Copy to /opt/lct-crm/.env on the test server and fill in real values.
# API_IMAGE, WEB_IMAGE and IMAGE_TAG are maintained by GitHub Actions after a
# successful deploy. Keep those entries in the server .env so manual Compose
# commands restart the exact CI-validated release.

ENV=test
AUTH_MODE=dev
LOG_LEVEL=INFO

POSTGRES_USER=crm
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=crm
SEED_ON_START=false

# User-uploaded imports and workflow attachments.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_BUCKET=crm-files

# Optional Redis/KeyDB cache. Leave both flags false until the service is
# provisioned and monitored in the target contour.
CACHE_ENABLED=false
CACHE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=60
FEATURE_CACHE_ENABLED=false
FEATURE_NOTIFICATIONS_ENABLED=false
FEATURE_EXTERNAL_CHANNELS_ENABLED=false
FEATURE_CHAT_ENABLED=false

# Kept only on the server. Email is addressed to the recipient's work email;
# Telegram delivers to the configured service chat.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# DNS A/AAAA records for both domains must point to this server.
# DOMAIN отдаёт и веб-интерфейс, и API: / — SPA, /api/ и /docs — бэкенд.
DOMAIN=crm.example.com
KEYCLOAK_DOMAIN=auth.crm.example.com
GRAFANA_DOMAIN=grafana.crm.example.com
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-keycloak-password

# KEYCLOAK_ISSUER здесь больше не задаётся: docker-compose.deploy.yml
# выводит его из DOMAIN и пути /kc — из того же значения, которое получает
# сам Keycloak. Так issuer в токене и issuer, который проверяет API, не могут
# разойтись. Значение из этого файла будет проигнорировано.
KEYCLOAK_AUDIENCE=

# Monitoring endpoints are not published by docker-compose.deploy.yml. Access
# them through a private network, VPN, or an authenticated reverse proxy.
PROMETHEUS_RETENTION_TIME=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
